ANTHROPIC_API_KEY=
MONGO_URI=mongodb://localhost:27017/silly-rabbit
TARGET_BASE_URL=https://<dev-env>
ALLOWED_DOMAINS=<dev-host>
# comma-separated plain hostnames (exact match, not regex) — e.g. app.example.com,example.com
PROD_URL_PATTERNS=
CORS_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
PORT=8000

# Dashboard auth — DASHBOARD_PASSWORD required, no default, yours to set, never checked in.
DASHBOARD_PASSWORD=<set-a-real-password>
# SESSION_SECRET=          # optional — auto-generated and persisted to .silly-rabbit/session-secret
                           # (gitignored) on first boot if unset; set explicitly to override.
# SESSION_SECRET_PATH=     # optional — where the auto-generated secret is read/written; default
                           # ../../.silly-rabbit/session-secret (relative to packages/backend, same
                           # offset DOTENV_CONFIG_PATH already uses)
# COOKIE_SECURE=false     # optional — set true once served over HTTPS
# COOKIE_SAME_SITE=lax    # optional — "lax" | "none" | "strict"; use "none" (with COOKIE_SECURE=true) if frontend/backend end up on different origins
# TRUST_PROXY=false       # optional — set true once behind a real reverse proxy (Cloudflare Pages, nginx, etc.), so req.ip reflects X-Forwarded-For instead of the proxy's own address
# TRUST_PROXY, COOKIE_SECURE, COOKIE_SAME_SITE, and CORS_ORIGIN all default to safe localhost values — flip at actual deploy time, see MILESTONES.md's Hosting checklist.
MAX_STEPS=40
MAX_LLM_CALLS=25
MAX_USD_PER_RUN=1.00
STORAGE_STATE_PATH=
# SCREENSHOT_STORAGE_CAP_MB=500  # optional — total-size cap on the screenshots/ dir; oldest deleted first once exceeded

# Auto-login — all 6 required to activate; leave blank to fall back to storageState.
TARGET_LOGIN_URL=
TARGET_EMAIL=
TARGET_PASSWORD=
TARGET_EMAIL_SELECTOR=
TARGET_PASSWORD_SELECTOR=
TARGET_SUBMIT_SELECTOR=
# TARGET_NEXT_SELECTOR=   # optional — only for 2-step (email → Next → password) login flows
# TIMEOUT_MS=              # optional — general ceiling for login's own explicit waits, default 10000
# LOGIN_READY_TIMEOUT_MS=  # optional — post-login readiness-wait override; falls back to TIMEOUT_MS
# TARGET_LOCATIONS_PATH=   # optional — real target's locations-flow route; unset falls back to the mock's own route
